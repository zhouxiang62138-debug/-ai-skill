{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/reference-scope-v1.schema.json",
  "title": "Reference scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_id", "reference_id", "requested_scope", "explicit_inclusions", "explicit_exclusions", "source_refs", "created_at", "context"],
  "properties": {
    "schema_version": {"const": 1},
    "scope_id": {"type": "string", "pattern": "^REFSCP-[0-9]{3}$"},
    "reference_id": {"type": "string", "pattern": "^REF-[0-9]{3}$"},
    "requested_scope": {"$ref": "reference-source-v1.schema.json#/$defs/scope"},
    "explicit_inclusions": {"type": "array", "uniqueItems": true, "items": {"$ref": "reference-source-v1.schema.json#/$defs/domain"}},
    "explicit_exclusions": {"type": "array", "uniqueItems": true, "items": {"$ref": "reference-source-v1.schema.json#/$defs/domain"}},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REF-[0-9]{3}$"}},
    "created_at": {"type": "string", "minLength": 1},
    "context": {"$ref": "reference-source-v1.schema.json#/$defs/context"},
    "supersedes": {"type": ["string", "null"]}
  }
}
