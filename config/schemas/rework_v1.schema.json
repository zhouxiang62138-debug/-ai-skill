{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Development Team rework record v1",
  "type": "object",
  "required": ["schema_version", "record_reference", "failure_class", "target_role", "retry_number", "source_evaluation", "required_evidence", "summary", "affected_artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "record_reference": {"type": "string", "pattern": "^memory/handoffs/rework-[0-9]{3}\\.md$"},
    "failure_class": {"enum": ["implementation_issue", "testing_issue", "product_scope_issue", "requirement_issue"]},
    "target_role": {"enum": [null, "planner", "generator"]},
    "retry_number": {"type": "integer", "minimum": 1, "maximum": 5},
    "source_evaluation": {"type": "string", "minLength": 1},
    "required_evidence": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "affected_artifacts": {"type": "array"}
  },
  "additionalProperties": true
}
