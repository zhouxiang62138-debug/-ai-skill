{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/reference-fusion-v1.schema.json",
  "title": "Reference evidence fusion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fusion_id", "reference_id", "input_hash", "selected_source_refs", "visual_source_refs", "conflicts", "limitations", "binding_status", "created_at", "trust_level"],
  "properties": {
    "schema_version": {"const": 1},
    "fusion_id": {"type": "string", "pattern": "^FUS-[0-9]{6}$"},
    "reference_id": {"type": "string", "pattern": "^REF-[0-9]{3}$"},
    "input_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "selected_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "visual_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "domain", "category", "deterministic_refs", "visual_refs", "resolution", "review_required"], "properties": {"conflict_id": {"type": "string", "pattern": "^REFCON-[0-9]{3}$"}, "domain": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "deterministic_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "visual_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "resolution": {"type": "string", "minLength": 1}, "review_required": {"type": "boolean"}}}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "binding_status": {"enum": ["READY", "REVIEW_REQUIRED", "BLOCKED"]},
    "created_at": {"type": "string", "minLength": 1},
    "trust_level": {"const": "untrusted"}
  }
}
