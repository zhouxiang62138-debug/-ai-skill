{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/perception-run-v1.schema.json",
  "title": "Reference perception run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "provider_id", "provider_version", "reference_id", "input_evidence_hashes", "requested_domains", "status", "limitations", "model_identity", "transport", "sdk_version", "trust_level", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^PER-[0-9]{6}$"},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_version": {"type": "integer", "minimum": 1},
    "reference_id": {"type": "string", "pattern": "^REF-[0-9]{3}$"},
    "input_evidence_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
    "requested_domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["UNAVAILABLE", "SUCCEEDED", "FAILED", "BLOCKED"]},
    "result_hash": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "failure_class": {"type": ["string", "null"], "enum": ["TEMPORARILY_UNAVAILABLE", "INVALID_INPUT", "MODEL_INVOCATION_FAILED", "STRUCTURED_OUTPUT_INVALID", null]},
    "failure_code": {"type": ["string", "null"], "minLength": 1},
    "model_identity": {"type": "string", "minLength": 1},
    "transport": {"type": "string", "minLength": 1},
    "sdk_version": {"type": ["string", "null"], "minLength": 1},
    "trust_level": {"const": "untrusted"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
