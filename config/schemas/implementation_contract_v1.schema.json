{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/implementation-contract-v1.schema.json",
  "title": "Conditional implementation contract v1",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "feature_id",
    "source_plan",
    "requirements",
    "acceptance_criteria",
    "risk_triggers",
    "done_when",
    "verification",
    "rollback_expectation",
    "risks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {
      "type": "string",
      "pattern": "^implementation-contract-[0-9]{3}$"
    },
    "feature_id": {"type": "string", "minLength": 1},
    "source_plan": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "requirements": {"type": "array", "minItems": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1},
    "risk_triggers": {"type": "array", "minItems": 1},
    "done_when": {"type": "array", "minItems": 1},
    "verification": {"type": "array", "minItems": 1},
    "rollback_expectation": {"type": "string", "minLength": 1},
    "risks": {"type": "array"}
  },
  "additionalProperties": false
}
