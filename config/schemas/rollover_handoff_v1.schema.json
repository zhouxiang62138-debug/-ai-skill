{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/rollover-handoff-v1.schema.json",
  "title": "Context rollover handoff v1",
  "type": "object",
  "required": [
    "completed",
    "current_state",
    "files_changed",
    "verification_completed",
    "open_issues",
    "known_failures",
    "next_actions",
    "important_decisions",
    "do_not_repeat",
    "references"
  ],
  "properties": {
    "completed": {"type": "array", "items": {"type": "string"}},
    "current_state": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "verification_completed": {"type": "array", "items": {"type": "string"}},
    "open_issues": {"type": "array", "items": {"type": "string"}},
    "known_failures": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "important_decisions": {"type": "array", "items": {"type": "string"}},
    "do_not_repeat": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
