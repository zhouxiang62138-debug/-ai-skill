{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/iteration-metrics-v1.schema.json",
  "title": "Evaluation Iteration Metrics v1",
  "type": "object",
  "required": [
    "previous_total_issues",
    "previous_blockers",
    "previous_critical",
    "resolved_issues",
    "reopened_issues",
    "repeated_issues",
    "new_issues",
    "new_regressions",
    "current_total_issues",
    "current_blockers",
    "current_critical",
    "progress_status"
  ],
  "properties": {
    "previous_total_issues": {"type": "integer", "minimum": 0},
    "previous_blockers": {"type": "integer", "minimum": 0},
    "previous_critical": {"type": "integer", "minimum": 0},
    "resolved_issues": {"type": "integer", "minimum": 0},
    "reopened_issues": {"type": "integer", "minimum": 0},
    "repeated_issues": {"type": "integer", "minimum": 0},
    "new_issues": {"type": "integer", "minimum": 0},
    "new_regressions": {"type": "integer", "minimum": 0},
    "current_total_issues": {"type": "integer", "minimum": 0},
    "current_blockers": {"type": "integer", "minimum": 0},
    "current_critical": {"type": "integer", "minimum": 0},
    "progress_status": {
      "enum": ["IMPROVING", "STABLE", "REGRESSING", "STALLED", "UNKNOWN"]
    }
  },
  "additionalProperties": false
}
