{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/browser-scenario-manifest-v1.schema.json",
  "title": "Browser Scenario Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "profile", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "artifact_kind": {"enum": ["approved", "template", "example"]},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id", "requirement_id", "acceptance_criterion_id",
          "preconditions", "steps", "expected_ui_state",
          "expected_api_state", "critical_workflow", "scenario_type"
        ],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "requirement_id": {"type": "string", "minLength": 1},
          "acceptance_criterion_id": {"type": "string", "minLength": 1},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "steps": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["action", "target"],
              "properties": {"action": {"type": "string"}, "target": {"type": "string"}, "expected": {"type": "string"}}
            }
          },
          "expected_ui_state": {
            "type": "object", "additionalProperties": false,
            "properties": {"success_state": {}, "saved": {}, "visible": {}, "text": {"type": "string"}}
          },
          "expected_api_state": {
            "type": "object", "additionalProperties": false,
            "properties": {"business_operation": {}, "status": {}, "resource": {}, "persistence": {}}
          },
          "critical_workflow": {"type": "boolean"},
          "scenario_type": {"enum": ["normal", "failure", "boundary", "persistence", "first_use"]}
        }
      }
    }
  }
}
