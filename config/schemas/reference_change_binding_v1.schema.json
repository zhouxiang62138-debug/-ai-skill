{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/reference-change-binding-v1.schema.json",
  "title": "Reference change request binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_id", "change_request_id", "project_id", "reference_ids", "synthesis_ref", "synthesis_version", "approved_change_scope", "change_scope_approval_ref", "baseline_manifest", "status", "supersedes", "created_at", "trust_level"],
  "properties": {
    "schema_version": {"const": 1},
    "binding_id": {"type": "string", "pattern": "^CRREF-[0-9]{4}$"},
    "change_request_id": {"type": "string", "pattern": "^CR-[0-9]{4}$"},
    "project_id": {"type": "string", "minLength": 1},
    "reference_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^REF-[0-9]{3}$"}},
    "synthesis_ref": {"type": "string", "pattern": "^change_requests/"},
    "synthesis_version": {"type": "integer", "minimum": 1},
    "approved_change_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "change_scope_approval_ref": {"type": "string", "pattern": "^approval-[0-9]{3}$"},
    "baseline_manifest": {"type": "string", "pattern": "^change_requests/"},
    "status": {"enum": ["ACTIVE", "REVOKED"]},
    "supersedes": {"type": ["string", "null"], "pattern": "^CRREF-[0-9]{4}$"},
    "created_at": {"type": "string", "minLength": 1},
    "trust_level": {"const": "untrusted"}
  }
}
