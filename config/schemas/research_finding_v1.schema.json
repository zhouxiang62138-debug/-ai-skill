{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/research-finding-v1.schema.json",
  "title": "Domain research finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "research_id", "epistemic_status", "claim", "source_refs", "evidence_refs", "confidence", "requirement_effect", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "finding_id": {"type": "string", "pattern": "^RRFND-[0-9]{3}$"},
    "research_id": {"type": "string", "pattern": "^RSRCH-[0-9]{3}$"},
    "epistemic_status": {"enum": ["FACT", "PATTERN", "OBSERVATION", "INFERENCE", "OPPORTUNITY", "IDEA"]},
    "domain": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^RRSRC-[0-9]{3}$"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "requirement_effect": {"enum": ["not_a_requirement", "candidate_supports", "candidate_contradicts", "unknown"]},
    "created_at": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]}
  }
}
