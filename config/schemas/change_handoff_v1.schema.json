{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/change-handoff-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "handoff_id", "change_request_id", "created_at", "implemented_items", "changed_files", "changed_file_hashes", "verification_results", "known_limitations", "rollback"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "handoff_id": {"type": "string", "pattern": "^handoff-[0-9]{3}$"},
    "change_request_id": {"type": "string", "pattern": "^CR-[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "implemented_items": {"type": "array", "minItems": 1},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "changed_file_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "verification_results": {"type": "array", "minItems": 1},
    "known_limitations": {"type": "array"},
    "rollback": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
