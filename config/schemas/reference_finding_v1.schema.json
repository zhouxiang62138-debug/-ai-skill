{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/reference-finding-v1.schema.json",
  "title": "Reference finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "reference_id", "domain", "category", "observation", "epistemic_status", "confidence", "evidence_refs", "user_scope_status", "trust_level", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "finding_id": {"type": "string", "pattern": "^REFFND-[0-9]{3}$"},
    "reference_id": {"type": "string", "pattern": "^REF-[0-9]{3}$"},
    "domain": {"$ref": "reference-source-v1.schema.json#/$defs/domain"},
    "category": {"type": "string", "minLength": 1},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {},
        "measurement": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/measurement"}]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "epistemic_status": {"enum": ["observed", "inferred", "unknown"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REFEV-[0-9]{3}$"}},
    "user_scope_status": {"enum": ["include", "exclude", "unspecified"]},
    "inference_basis": {"type": "array", "items": {"type": "string"}},
    "unknown_reason": {"type": ["string", "null"]},
    "supersedes": {"type": ["string", "null"]},
    "trust_level": {"const": "untrusted"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_type", "unit"],
      "properties": {
        "value_type": {"enum": ["measured", "estimated_range", "estimated_tolerance"]},
        "estimate": {"type": ["number", "null"]},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "tolerance": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  }
}
