{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/opportunity-map-v1.schema.json",
  "title": "Creative opportunity map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "opportunity_id", "project_id", "creativity_profile", "candidates", "governance_policy", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "opportunity_id": {"type": "string", "pattern": "^OPP-[0-9]{3}$"},
    "project_id": {"type": "string", "minLength": 1},
    "creativity_profile": {"enum": ["conservative", "balanced", "innovative"]},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "title", "description", "mode", "evidence_refs", "decision_status"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "mode": {"enum": ["PATTERN", "OPPORTUNITY", "IDEA"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "decision_status": {"enum": ["candidate", "recommended", "selected", "deferred", "rejected"]},
          "requires_user_decision": {"type": "boolean"}
        }
      }
    },
    "governance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["never_auto_promote_to_requirement", "user_goal_check_required", "scope_impact_check_required"],
      "properties": {
        "never_auto_promote_to_requirement": {"const": true},
        "user_goal_check_required": {"const": true},
        "scope_impact_check_required": {"const": true}
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]}
  }
}
