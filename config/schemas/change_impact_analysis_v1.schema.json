{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/change-impact-analysis-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "change_request_id", "created_at", "risk_level", "scope_change", "items", "testing_impact", "approval_questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "change_request_id": {"type": "string", "pattern": "^CR-[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "scope_change": {"type": "boolean"},
    "database_migration_required": {"type": "boolean"},
    "new_dependencies_required": {"type": "boolean"},
    "backward_compatibility_risk": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH"]},
    "items": {"type": "array", "minItems": 1},
    "affected_components": {"type": "array", "items": {"type": "string"}},
    "testing_impact": {"type": "object"},
    "approval_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
