{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/change-approval-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "approval_id", "change_request_id", "created_at", "decision", "item_decisions", "source_text"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "pattern": "^approval-[0-9]{3}$"},
    "change_request_id": {"type": "string", "pattern": "^CR-[0-9]{4}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["APPROVED", "PARTIALLY_APPROVED", "REJECTED", "CANCELLED", "REVISION_REQUESTED"]},
    "item_decisions": {"type": "array", "minItems": 1},
    "source_text": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
