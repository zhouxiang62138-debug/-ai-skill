{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/candidate-v2.schema.json",
  "title": "Profile-bound validated Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "snapshot_id", "evaluation_id",
    "project_revision", "score", "blocking_issues", "critical_issues",
    "regression_status", "feature_completeness", "browser_acceptance",
    "validated_at", "evaluation_profile", "evaluation_profile_hash",
    "rubric_version", "evaluator_model", "calibration_suite_version",
    "required_gate_results"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "candidate_id": {"type": "string", "pattern": "^candidate-[0-9]{3}$"},
    "snapshot_id": {"type": "string", "pattern": "^snapshot-[A-Za-z0-9_-]+$"},
    "evaluation_id": {"type": "string", "pattern": "^evaluation-[0-9]{3}$"},
    "project_revision": {"type": "integer", "minimum": 0},
    "score": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "blocking_issues": {"type": "array", "items": {"type": "string"}},
    "critical_issues": {"type": "array", "items": {"type": "string"}},
    "regression_status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "feature_completeness": {"type": "string"},
    "browser_acceptance": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"]},
    "validated_at": {"type": "string", "minLength": 1},
    "evaluation_profile": {"type": "string", "minLength": 1},
    "evaluation_profile_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rubric_version": {"type": "string", "minLength": 1},
    "evaluator_model": {"type": "string", "minLength": 1},
    "calibration_suite_version": {"type": "string", "minLength": 1},
    "required_gate_results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"]}
    },
    "workspace_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
