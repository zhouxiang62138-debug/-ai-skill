{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/ai-development-team/acquisition-manifest-v1.schema.json",
  "title": "Reference acquisition manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_type",
    "acquisition_id",
    "reference_id",
    "source_type",
    "request_fingerprint",
    "provider_id",
    "provider_version",
    "snapshot_version",
    "status",
    "attempt",
    "artifact_refs",
    "evidence_refs",
    "history",
    "created_at",
    "updated_at",
    "trust_level"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_type": {"const": "acquisition_manifest"},
    "acquisition_id": {"type": "string", "pattern": "^ACQ-[0-9]{6}$"},
    "reference_id": {"type": "string", "pattern": "^REF-[0-9]{3}$"},
    "source_type": {"type": "string", "minLength": 1},
    "request_fingerprint": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_version": {"type": "integer", "minimum": 1},
    "snapshot_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["REQUESTED", "STARTED", "SUCCEEDED", "FAILED", "TIMED_OUT", "CANCELLED", "UNKNOWN_AFTER_CRASH"]},
    "attempt": {"type": "integer", "minimum": 1},
    "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^REFEV-[0-9]{3}$"}},
    "error_code": {"type": ["string", "null"]},
    "refresh_of": {"type": ["string", "null"], "pattern": "^ACQ-[0-9]{6}$"},
    "history": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "manifest_artifact_ref": {"type": "string", "minLength": 1},
    "trust_level": {"const": "untrusted"}
  }
}
